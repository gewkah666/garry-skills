# garry-skills environment variables
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored (see .gitignore), so it stays on your machine only.

# ─── MiniMax (cn endpoint, used by miloco_hermes_bridge.py, miloco_tts.py) ───
# Required: any one of these will be picked up
MINIMAX_API_KEY=sk-cp-your-key-here
# MINIMAX_CN_API_KEY=sk-cp-your-key-here    # alias (mm-cli / Hermes-style)
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M3

# ─── Notion (for dev-tasks skill) ───
NOTION_API_KEY=ntn_your-key-here
